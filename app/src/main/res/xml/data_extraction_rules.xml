<?xml version="1.0" encoding="utf-8"?>
<!--
  The login to an Audiobookshelf server stays out of the cloud backup. Moving to a new phone takes it along.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="audiobookshelf/account.json" />
  </cloud-backup>
</data-extraction-rules>
