default_platform(:android)

def parse_version_code_option!(options)
  version_code = options[:version_code].to_i
  UI.user_error!("version_code must be numeric") if version_code <= 0
  version_code
end

platform :android do
  lane :upload_internal do |options|
    aab_path = options[:aab_path]
    upload_to_play_store(
      track: 'internal',
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  lane :upload_metadata do
    # supply only uploads the listing when it can match a release on the track
    version_code = google_play_track_version_codes.max

    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      sync_image_upload: true,
      version_code: version_code
    )
  end

  # Starts the production rollout of a build that Play already has, at 0.1%.
  lane :promote do |options|
    version_code = parse_version_code_option!(options)

    # The Play API returns the codes as strings.
    if google_play_track_version_codes(track: 'production').map(&:to_i).include?(version_code)
      UI.user_error!("#{version_code} is already on production")
    end

    # Promoting from the internal track only works for the newest build there, and a later
    # release or internal upload replaces it. version_codes_to_retain puts a build that Play
    # already has on the track, wherever it is now.
    supply(
      track: 'production',
      version_codes_to_retain: [version_code],
      rollout: "0.001", # 0.1%
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
