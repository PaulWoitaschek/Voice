{
  "permissions": {
    "allow": [
      "Bash(git revert *)",
      "Bash(git grep *)",
      "Bash(git merge-base *)",
      "Bash(git ls-tree *)",
      "Bash(gh search *)",
      "Bash(adb devices *)",
      "Bash(adb logcat *)",
      "Bash(adb shell dumpsys *)",
      "Bash(adb shell pidof *)",
      "Bash(adb shell settings get *)",
      "Bash(.agents/skills/emulator/scripts/emulator.py list)",
      "Bash(.agents/skills/emulator/scripts/ui.py dump *)",
      "Bash(.agents/skills/emulator/scripts/ui.py books *)",
      "Bash(.agents/skills/emulator/scripts/ui.py screenshot *)",
      "Bash(.agents/skills/translate-strings/scripts/missing_translations.main.kts *)",
      "Bash(javap *)",
      "Bash(ffprobe *)",
      "Bash(unzip -l *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks"
          }
        ]
      }
    ]
  }
}
