<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application>

    <receiver
      android:name="voice.app.features.widget.BaseWidgetProvider"
      android:exported="true"
      android:label="@string/widget.now_playing.label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_now_playing_info" />
    </receiver>

    <receiver
      android:name="voice.features.widget.ShelfWidgetReceiver"
      android:exported="true"
      android:label="@string/widget.shelf.label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_shelf_info" />
    </receiver>

    <receiver
      android:name="voice.features.widget.SleepTimerWidgetReceiver"
      android:exported="true"
      android:label="@string/widget.sleep_timer.label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_sleep_timer_info" />
    </receiver>

  </application>

</manifest>
