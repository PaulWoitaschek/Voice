context platform=android
open "de.ph1b.audiobook" --relaunch
wait 'label="Search your library"' 15000
press 'label="Snakey"'
wait 'text="00:00"' 10000
press 'label="Play"'
wait 'label="Pause"' 5000
wait absent 'text="00:00"' 10000
press 'label="Pause"'
wait 'label="Play"' 5000
press 'label="Close"'
wait 'label="Search your library"' 5000
close
