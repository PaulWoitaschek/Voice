---
import Decor from '../components/Decor.astro'
import Base from './Base.astro'

// Markdown pages pass their frontmatter, Astro pages pass title and description directly.
// A page with `toc: true` in its frontmatter gets a side menu of its sections.
type Props = {
  title?: string
  description?: string
  frontmatter?: { title: string; description?: string; toc?: boolean }
  headings?: { depth: number; slug: string; text: string }[]
}
const { frontmatter } = Astro.props
const title = frontmatter?.title ?? Astro.props.title
const description = frontmatter?.description ?? Astro.props.description
const sections = frontmatter?.toc ? (Astro.props.headings ?? []).filter((heading) => heading.depth === 2) : []
---

<Base description={description} title={title}>
  <div aria-hidden="true" class="band tone" data-tone="day">
    <Decor
      shapes={[
        { kind: 'cookie', x: 92, y: 30, r: 130, rotate: 10, color: 2 },
        { kind: 'flower', x: 6, y: 90, r: 80, color: 1 },
      ]}
    />
  </div>
  {
    sections.length > 0 ? (
      <div class="wrap with-toc">
        <nav aria-label="On this page" class="toc">
          <p class="toc-title">On this page</p>
          <ol>
            {sections.map((section) => (
              <li>
                <a href={`#${section.slug}`}>{section.text}</a>
              </li>
            ))}
          </ol>
        </nav>
        <article class="prose">
          <slot />
        </article>
      </div>
    ) : (
      <article class="wrap prose">
        <slot />
      </article>
    )
  }
</Base>

<script>
  // In the browser, as Astro gives the headings their ids after all Markdown plugins ran.
  for (const heading of document.querySelectorAll('.prose :is(h2, h3)[id]')) {
    const link = document.createElement('a')
    link.href = `#${heading.id}`
    link.append(...heading.childNodes)
    heading.append(link)
  }

  // Marks the section being read in the side menu: the last one whose heading scrolled past the top third.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')]
  const targets = links.flatMap((link) => {
    const target = document.getElementById(decodeURIComponent(link.hash.slice(1)))
    return target ? [{ link, target }] : []
  })
  if (targets.length > 0) {
    let frame = 0
    const update = () => {
      frame = 0
      const line = window.innerHeight / 3
      let current = targets.findLast(({ target }) => target.getBoundingClientRect().top <= line) ?? targets[0]
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = targets.at(-1)!
      for (const { link } of targets) {
        if (link === current.link) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      }
    }
    const schedule = () => {
      if (frame === 0) frame = requestAnimationFrame(update)
    }
    addEventListener('scroll', schedule, { passive: true })
    addEventListener('resize', schedule)
    update()
  }
</script>

<style>
  .band {
    position: absolute;
    inset: 0 0 auto;
    height: 440px;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .prose {
    position: relative;
    max-width: 800px;
    padding-top: calc(var(--header-height) + clamp(32px, 6vw, 72px));
    padding-bottom: 32px;
  }

  .with-toc {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 800px);
    justify-content: center;
    padding-top: calc(var(--header-height) + clamp(32px, 6vw, 72px));
    padding-bottom: 32px;
  }

  .with-toc .prose {
    padding-bottom: 0;
  }

  .with-toc .prose {
    padding-top: 0;
  }

  /* On narrow screens the menu sits under the title, so the article's children join the grid to place it there. */
  @media (max-width: 1099px) {
    .with-toc .prose {
      display: contents;
    }

    .with-toc .prose > :global(*) {
      order: 2;
    }

    .with-toc .prose > :global(h1) {
      order: 0;
    }

    .toc {
      order: 1;
    }

    .toc a[aria-current]:not(:hover) {
      background: none;
      color: var(--text-muted);
      font-weight: inherit;
    }
  }

  .toc {
    margin-bottom: 40px;
    padding: 20px 24px;
    border-radius: 24px;
    background: var(--card);
    border: 1px solid var(--card-line);
    font-size: 1rem;
    line-height: 1.35;
  }

  .toc-title {
    margin-bottom: 12px;
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .toc ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: block;
    padding: 8px 12px;
    border-radius: 12px;
    color: var(--text-muted);
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .toc a:hover {
    background: var(--tonal);
    color: var(--on-tonal);
  }

  .toc a[aria-current] {
    background: var(--tonal);
    color: var(--on-tonal);
    font-weight: 600;
  }

  /* Beside the text once both fit, and it stays in view while reading. */
  @media (min-width: 1100px) {
    .with-toc {
      grid-template-columns: 280px minmax(0, 800px);
      gap: 56px;
    }

    .toc {
      position: sticky;
      top: 24px;
      align-self: start;
      max-height: calc(100vh - 48px);
      overflow-y: auto;
      margin-top: 8px;
      margin-bottom: 0;
      padding: 16px 12px;
      background: none;
      border: 0;
    }

    .toc-title {
      padding-inline: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc a {
      transition: none;
    }
  }

  .prose :global(h1) {
    margin-bottom: 40px;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
  }

  .prose :global(h2) {
    margin: 2.2em 0 0.6em;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.9rem);
    line-height: 1.2;
    scroll-margin-top: 24px;
  }

  .prose :global(h3) {
    margin: 1.8em 0 0.5em;
    scroll-margin-top: 24px;
  }

  .prose :global(:is(h1, h2, h3) + *) {
    margin-top: 0;
  }

  .prose :global(:is(p, ul, ol, pre, table)) {
    margin: 0 0 1em;
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(li::marker) {
    color: var(--primary);
  }

  .prose :global(a) {
    color: var(--primary);
    font-weight: 550;
  }

  .prose :global(:is(h2, h3) > a) {
    color: inherit;
    font-weight: inherit;
    text-decoration: none;
  }

  .prose :global(:is(h2, h3) > a::after) {
    content: '#';
    margin-left: 0.3em;
    color: var(--primary);
    opacity: 0;
  }

  .prose :global(:is(h2, h3) > a:is(:hover, :focus-visible)::after) {
    opacity: 1;
  }

  .prose :global(code) {
    padding: 0.1em 0.4em;
    border-radius: 8px;
    background: var(--tonal);
    color: var(--on-tonal);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 20px 24px;
    border-radius: 24px;
    background: var(--card);
    border: 1px solid var(--card-line);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    color: var(--text);
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .prose :global(:is(th, td)) {
    padding: 10px 16px;
    border-bottom: 1px solid var(--card-line);
    text-align: left;
  }

  .prose :global(th) {
    font-weight: 650;
  }

  .prose :global(strong) {
    font-weight: 650;
  }

  .prose :global(blockquote) {
    margin: 0 0 2em;
    padding: 20px 24px;
    border-radius: 24px;
    background: var(--tonal);
    color: var(--on-tonal);
  }

  .prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .prose :global(hr) {
    margin: 3em 0;
    border: 0;
    border-top: 1px solid var(--card-line);
  }
</style>
